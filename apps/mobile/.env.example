# Local dev values come from `supabase status` (URL + publishable key on the 553xx ports).
# Dev/prod values come from the Supabase dashboard. Real values live ONLY in untracked
# .env files locally and in EAS env vars for builds (docs/spec/23 §2). Never commit secrets.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_replace_me

# Observability (W2.10). Every one of these is OPTIONAL and absence is a clean no-op:
# no PostHog key means no analytics client is ever built, no Sentry DSN means Sentry is
# never initialised. Both values are public by design (they identify a project, they do not
# grant anything), like the Supabase publishable key above.
# Leave them unset for local work unless you are deliberately verifying the pipes.
EXPO_PUBLIC_POSTHOG_KEY=
# Defaults to https://eu.i.posthog.com when unset. EU residency is a docs/spec/20
# requirement, so only ever point this at an EU host.
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_SENTRY_DSN=

# Build-time only, and only in EAS env (docs/spec/21 §4): with both set, the Expo plugin
# uploads sourcemaps during the native build so stack traces are readable. SENTRY_AUTH_TOKEN
# is a real secret and belongs in EAS/GitHub secrets, never here and never in git.
SENTRY_ORG=
SENTRY_PROJECT=

# Pseudo-localization (W4.6, docs/spec/22 §4). Set to 1 and restart Metro with
# `--clear` to render every screen in an accented, expanded, bracketed locale
# derived from English: `[[Ŕéàð ťĥé ƒüļļ ƥŕïṽàçý ƥôļïçý······]]`. Brackets mark the
# ends of each string, so a sentence assembled from several keys shows its seams
# and a container that cannot hold its text shows the truncation. DEV ONLY: the
# switch is `__DEV__ &&` this value, so a release build cannot reach it, and it is
# never offered in the language picker. Leave unset for ordinary work.
EXPO_PUBLIC_PSEUDO_LOCALE=
